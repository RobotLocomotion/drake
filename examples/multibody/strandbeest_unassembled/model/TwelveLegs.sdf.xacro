<?xml version="1.0"?>
<!--
The twelve legs of Theo Jansen's Strandbeest, described as UNASSEMBLED parts:
six pairs of mirror-image legs along the crankshaft, with their cranks a sixth
of a turn apart, as in examples/multibody/strandbeest. See JansenParts.xacro
for the parts, and strandbeest_unassembled.cc, which assembles and runs this
model.

The chassis is welded to World, and the crankshaft turns on it. Each leg's ten
bars form five kinematic loops, which MultibodyPlant breaks automatically.
-->
<sdf version="1.9" xmlns:xacro="http://ros.org/wiki/xacro"
     xmlns:drake="http://drake.mit.edu">
  <xacro:include filename="JansenParts.xacro"/>
  <model name="twelve_legs">
    <xacro:chassis_and_crankshaft width="1.3" height="1"/>
    <xacro:leg_pair prefix="pair1_" y="0.6" phase="0"/>
    <xacro:leg_pair prefix="pair2_" y="0.36" phase="${2*pi/3}"/>
    <xacro:leg_pair prefix="pair3_" y="0.12" phase="${4*pi/3}"/>
    <xacro:leg_pair prefix="pair4_" y="-0.12" phase="${pi/3}"/>
    <xacro:leg_pair prefix="pair5_" y="-0.36" phase="${pi}"/>
    <xacro:leg_pair prefix="pair6_" y="-0.6" phase="${5*pi/3}"/>
  </model>
</sdf>
