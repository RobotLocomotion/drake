<?xml version="1.0"?>
<!--
Eight legs of Theo Jansen's Strandbeest, described as UNASSEMBLED parts: four
pairs of mirror-image legs along the crankshaft, with their cranks a quarter
turn apart. See JansenParts.xacro for the parts, and
strandbeest_unassembled.cc, which assembles and runs this model.

The chassis floats free, held up only by its legs, and the crankshaft turns on
it, so that the legs walk it along the ground. Each leg's four bars and two
triangles form three kinematic loops, which MultibodyPlant breaks automatically
by splitting a part of each loop in two.
-->
<sdf version="1.9" xmlns:xacro="http://ros.org/wiki/xacro"
     xmlns:drake="http://drake.mit.edu">
  <xacro:include filename="JansenParts.xacro"/>
  <model name="eight_legs">
    <xacro:ground/>
    <xacro:chassis_and_crankshaft width="0.9"/>
    <xacro:leg_pair prefix="pair1_" y="0.12" phase="0"/>
    <xacro:leg_pair prefix="pair2_" y="-0.12" phase="${pi}"/>
    <xacro:leg_pair prefix="pair3_" y="0.36" phase="${0.5*pi}"/>
    <xacro:leg_pair prefix="pair4_" y="-0.36" phase="${1.5*pi}"/>
  </model>
</sdf>
