load("//tools/lint:lint.bzl", "add_lint_tests")
load(
    "//tools/skylark:drake_cc.bzl",
    "drake_cc_binary",
    "drake_cc_library",
)

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "models",
    srcs = glob([
        "**/*.sdf",
    ]),
    visibility = [
        "//:__pkg__",
        "//bindings/pydrake/multibody:__pkg__",
    ],
)

drake_cc_binary(
    name = "four_bar",
    srcs = ["four_bar.cc"],
    data = [":models"],
    deps = [
        "//multibody/parsing",
        "//multibody/plant",
        "//systems/analysis:simulator",
        "//systems/analysis:simulator_gflags",
        "//systems/analysis:simulator_print_stats",
        "//systems/framework:diagram",
        "//visualization:visualization_config_functions",
        "@gflags",
    ],
    add_test_rule = True,
    test_rule_args = [
        "--simulation_time=0.1",
        "--nointeractive",
    ],
)

drake_cc_library(
    name = "assemble_nearest_configuration",
    srcs = ["assemble_nearest_configuration.cc"],
    hdrs = ["assemble_nearest_configuration.h"],
    deps = [
        "//multibody/inverse_kinematics",
        "//multibody/plant",
        "//solvers:mathematical_program",
        "//solvers:mathematical_program_result",
        "//solvers:solve",
        "//systems/framework:context",
    ],
)

drake_cc_binary(
    name = "four_bar_unassembled",
    srcs = ["four_bar_unassembled.cc"],
    data = [":models"],
    deps = [
        ":assemble_nearest_configuration",
        "//geometry:geometry_instance",
        "//geometry:geometry_roles",
        "//geometry:scene_graph",
        "//geometry:shape_specification",
        "//math:geometric_transform",
        "//multibody/parsing",
        "//multibody/plant",
        "//multibody/tree",
        "//solvers:mathematical_program_result",
        "//systems/analysis:simulator",
        "//systems/analysis:simulator_gflags",
        "//systems/analysis:simulator_print_stats",
        "//systems/framework:diagram",
        "//visualization:visualization_config_functions",
        "@fmt",
        "@gflags",
    ],
    add_test_rule = True,
    test_rule_args = [
        "--simulation_time=0.1",
        "--nointeractive",
        # Long enough to exercise the playback, short enough not to slow the
        # test.
        "--assembly_playback_time=0.2",
    ],
)

drake_cc_binary(
    name = "four_bar_with_bushing",
    srcs = ["four_bar_with_bushing.cc"],
    data = [":models"],
    deps = [
        "//multibody/parsing",
        "//multibody/plant",
        "//multibody/tree",
        "//systems/analysis:simulator",
        "//systems/analysis:simulator_gflags",
        "//systems/analysis:simulator_print_stats",
        "//systems/framework:diagram",
        "//visualization:visualization_config_functions",
        "@gflags",
    ],
    add_test_rule = True,
    test_rule_args = [
        "--simulation_time=0.1",
    ],
)

add_lint_tests()
