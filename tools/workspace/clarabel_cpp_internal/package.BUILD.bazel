# -*- bazel -*-

load("@drake//tools/install:install.bzl", "install")
load("@drake//tools/skylark:cc.bzl", "cc_library")
load("@drake//tools/skylark:cc_hidden.bzl", "cc_wrap_static_archive_hidden")
load("@drake//tools/workspace:vendor_cxx.bzl", "cc_library_vendored")
load("@drake//tools/workspace/crate_universe:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")

package(default_visibility = ["//visibility:private"])

licenses(["notice"])  # Apache-2.0

exports_files([
    "LICENSE.md",
    "include/cpp/DefaultSettings.hpp",
    "rust_wrapper/Cargo.toml",
])

_HDRS = glob(
    ["include/**"],
    allow_empty = False,
)

cc_library_vendored(
    name = "hdrs",
    hdrs = _HDRS,
    hdrs_vendored = [
        x.replace("include/", "drake_hdr/")
        for x in _HDRS
    ],
    defines = [
        "FEATURE_SDP",
    ],
    includes = ["drake_hdr"],
    isystem = True,
    linkstatic = True,
)

rust_static_library(
    name = "clarabel_cpp_rust_wrapper",
    srcs = glob(
        ["rust_wrapper/src/**/*.rs"],
        allow_empty = False,
    ),
    crate_features = ["sdp"],
    edition = "2021",
    deps = all_crate_deps(),
)

cc_wrap_static_archive_hidden(
    name = "clarabel_cpp_rust_wrapper_hidden",
    static_archive_name = "clarabel_cpp_rust_wrapper",
)

# Combine the public headers with the object code. On macOS, avoid -force_load
# because the Rust archive and @llvm both contain compiler-rt.
cc_library(
    name = "clarabel_cpp",
    additional_linker_inputs = select({
        "@drake//tools/cc_toolchain:apple": [
            ":_clarabel_cpp_rust_wrapper_hidden_osx.a",
        ],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@drake//tools/cc_toolchain:apple": [
            "$(location :_clarabel_cpp_rust_wrapper_hidden_osx.a)",
        ],
        "//conditions:default": [],
    }),
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        ":hdrs",
        "@blas",
        "@eigen",
        "@lapack",
    ] + select({
        "@drake//tools/cc_toolchain:apple": [],
        "//conditions:default": [
            ":clarabel_cpp_rust_wrapper_hidden",
        ],
    }),
)

install(
    name = "install",
    docs = ["LICENSE.md"],
    visibility = ["//visibility:public"],
)

exports_files(["drake_repository_metadata.json"])
