+//------------------------------------------------------------------------------
+bool vtkSubjectHelper::HasEffectiveObserver(unsigned long event, std::set<vtkObject*>& visited)
+{
+  for (auto& [key, obs] : this->Observers)
+  {
+    if (obs.Event != event && obs.Event != vtkCommand::AnyEvent)
+    {
+      continue;
+    }
+    vtkObject* target = obs.Command->GetEventForwardTarget();
+    if (!target)
+    {
+      // A command that handles the event itself, so the event is effectively
+      // observed.
+      return true;
+    }
+    // A forwarding command: the event is only effectively observed if the
+    // target (transitively) has an effective observer of its own. The visited
+    // set guards against cycles among forwarders.
+    if (visited.insert(target).second && target->SubjectHelper &&
+      target->SubjectHelper->HasEffectiveObserver(event, visited))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
