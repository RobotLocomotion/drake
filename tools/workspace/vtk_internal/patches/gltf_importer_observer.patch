 vtkTypeBool vtkSubjectHelper::InvokeEvent(unsigned long event, void* callData, vtkObject* self)
 {
@@ -861,6 +890,24 @@ vtkTypeBool vtkObject::HasObserver(unsigned long event, vtkCommand* cmd)
   return 0;
 }

+//------------------------------------------------------------------------------
+vtkTypeBool vtkObject::HasEffectiveObserver(unsigned long event)
+{
+  if (this->SubjectHelper)
+  {
+    std::set<vtkObject*> visited;
+    visited.insert(this);
+    return this->SubjectHelper->HasEffectiveObserver(event, visited) ? 1 : 0;
+  }
+  return 0;
+}
+
+//------------------------------------------------------------------------------
+vtkTypeBool vtkObject::HasEffectiveObserver(const char* event)
+{
+  return this->HasEffectiveObserver(vtkCommand::GetEventIdFromString(event));
+}
+
