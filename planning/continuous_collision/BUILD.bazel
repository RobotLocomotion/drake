    hdrs = ["internal.h"],
    internal = True,
    visibility = ["//visibility:private"],
    deps = [
        "//common:unused",
        "//geometry:geometry_ids",
        "//geometry:shape_specification",
        "//multibody/tree:multibody_tree_indexes",
    ],
)

drake_cc_library(
    name = "piecewise_bezier_path",
    srcs = ["piecewise_bezier_path.cc"],
    hdrs = ["piecewise_bezier_path.h"],
    internal = True,
    visibility = ["//visibility:private"],
    deps = [
        "//common:essential",
        "//common/trajectories:trajectory",
        "@eigen",
    ],
    implementation_deps = [
        ":internal",
        "//common:nice_type_name",
        "//common/trajectories:bezier_curve",
        "//common/trajectories:bspline_trajectory",
        "//common/trajectories:composite_trajectory",
        "//common/trajectories:piecewise_polynomial",
