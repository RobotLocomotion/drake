# The bounding-sphere radius property test.
drake_cc_googletest(
    name = "bounding_sphere_test",
    deps = [
        ":bounding_sphere",
        ":test_utilities",
        "//common:essential",
        "//common:memory_file",
        "//common/test_utilities:expect_throws_message",
