drake_cc_library(
    name = "test_utilities",
    testonly = 1,
    hdrs = ["test/test_utilities.h"],
    deps = [
        ":continuous_collision_checker",
        ":distance_oracle",
        "//common:parallelism",
        "//common/trajectories:bezier_curve",
        "//geometry:scene_graph",
        "//geometry:shape_specification",
        "//math:geometric_transform",
        "//multibody/plant",
        "//multibody/tree",
        "//planning:robot_diagram",
        "//planning:robot_diagram_builder",
        "@googletest//:gtest",
    ],
)

