drake_cc_googletest(
    name = "motion_bound_test",
    deps = [
        ":motion_bound_table",
        "//geometry:geometry_roles",
        "//geometry:scene_graph_inspector",
        "//geometry:shape_specification",
        "//math:geometric_transform",
        "//multibody/plant",
        "//multibody/tree",
        "//planning:robot_diagram_builder",
    ],
